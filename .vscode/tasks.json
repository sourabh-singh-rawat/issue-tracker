{
  "version": "2.0.0",
  "presentation": {
    "echo": true,
    "reveal": "always",
    "focus": false,
    "panel": "shared",
    "showReuseMessage": true,
    "clear": false
  },
  "tasks": [
    {
      "label": "infra: up",
      "detail": "Start Docker infra. Run once; keep running while developing.",
      "type": "shell",
      "command": "pnpm dev:infra",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "infra: down",
      "type": "shell",
      "command": "pnpm dev:infra:down",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "schemas:compose",
      "type": "shell",
      "command": "pnpm schemas:compose",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "gen",
      "detail": "Regenerate pine-web GraphQL + OpenAPI clients.",
      "type": "shell",
      "command": "pnpm gen",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
